    {
      "parameters": {
        "jsCode": "const lat = $json.latitude;\nconst lon = $json.longitude;\nconst offset = 0.05;\n\n// 1. دالة تقدير المنطقة الزمنية في الولايات المتحدة بناءً على خط الطول (Longitude)\nfunction getTimezone(lng) {\n  if (lng > -85.0) return 'America/New_York';       // Eastern Time (ET)\n  if (lng > -103.0) return 'America/Chicago';      // Central Time (CT)\n  if (lng > -114.0) return 'America/Denver';       // Mountain Time (MT)\n  return 'America/Los_Angeles';                    // Pacific Time (PT)\n}\n\n// 2. تحديد المنطقة الزمنية وحساب الوقت والتاريخ المحلي للمزارع\nconst userTimezone = getTimezone(lon);\n//const localTime = DateTime.now().setZone(userTimezone);\nconst localTime = DateTime.now().setZone(userTimezone).minus({ hours: 3 });\n\nreturn [{\n  json: {\n    latitude: lat,\n    longitude: lon,\n    timezone: userTimezone,\n    start_date: localTime.toFormat('yyyy-MM-dd'),\n    start_time: localTime.toFormat('HH:00'),\n    polygon_aoi: {\n      type: \"FeatureCollection\",\n      features: [{\n        type: \"Feature\",\n        properties: {},\n        geometry: {\n          type: \"Polygon\",\n          coordinates: [[\n            [lon - offset, lat - offset],\n            [lon + offset, lat - offset],\n            [lon + offset, lat + offset],\n            [lon - offset, lat + offset],\n            [lon - offset, lat - offset]\n          ]]\n        }\n      }]\n    }\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        384,
        0
      ],
